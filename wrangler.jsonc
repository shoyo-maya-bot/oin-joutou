{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "oin-joutou",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // database_id を書かなくても、初回デプロイ時に oin-ranking が自動で作られる
  "d1_databases": [
    { "binding": "DB", "database_name": "oin-ranking" }
  ],
  "observability": { "enabled": true }
}
